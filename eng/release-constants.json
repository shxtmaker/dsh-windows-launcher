{
  "$schema": "./release-constants.schema.json",
  "schemaVersion": 5,
  "releaseStatus": "candidate",
  "product": {
    "name": "DSH Windows Launcher",
    "executableName": "DshWindowsLauncher.exe",
    "applicationDataId": "DshWindowsLauncher",
    "applicationDataRoot": "%LOCALAPPDATA%\\DshWindowsLauncher",
    "defaultInstallRoot": "%LOCALAPPDATA%\\Programs\\DshWindowsLauncher",
    "version": "2.0.1"
  },
  "platform": {
    "supportedWindows": "Windows 11 25H2+ x64",
    "compatibilityWindows": "Windows 10 22H2 x64",
    "linuxReference": "Ubuntu Server 24.04 LTS x64"
  },
  "build": {
    "dotnetSdkVersion": "10.0.400",
    "targetFramework": "net10.0-windows",
    "runtimeIdentifier": "win-x64",
    "selfContained": true,
    "singleFile": false,
    "trimmed": false
  },
  "pairingBaseline": {
    "plugin": "@linxin666/dsh-remote-web-ui",
    "referenceVersion": "0.3.10",
    "cookieName": "dsh_pair",
    "acceptPage": "/pair-accept",
    "acceptPath": "/api/pair/accept",
    "heartbeatPath": "/api/pair/heartbeat",
    "statusPath": "/api/pair/status",
    "onlineWindowSeconds": 25,
    "defaultHeartbeatIntervalSeconds": 10
  },
  "verificationBaseline": {
    "lastSupportedReleaseCommit": null
  },
  "distribution": {
    "installerFileNameTemplate": "{Product}-Setup-{SemVer}-win-x64.exe",
    "innoSetup": {
      "appId": "4440FC88-98CA-403E-8E20-3DFEBEF0E609",
      "version": "7.0.2",
      "sourceUri": "https://github.com/jrsoftware/issrc/releases/download/is-7_0_2/innosetup-7.0.2-x64.exe",
      "sha256": "5ad54ca3def786f8f4212552e54cc6d8d61329e2d24a1cfee0571d42c2684ff1"
    },
    "signing": {
      "policy": "none",
      "publisher": "lqy"
    },
    "officialReleaseUri": "http://192.168.3.100:3300/lqy/dsh-windows-launcher/releases/tag/v2.0.1"
  },
  "limits": {
    "maxTargets": 32
  }
}
