{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/dsh-windows-launcher/release-constants.schema.json",
  "title": "DSH Windows Launcher release constants",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "releaseStatus",
    "product",
    "platform",
    "build",
    "pairingBaseline",
    "verificationBaseline",
    "distribution",
    "limits"
  ],
  "properties": {
    "$schema": {
      "const": "./release-constants.schema.json"
    },
    "schemaVersion": {
      "const": 4
    },
    "releaseStatus": {
      "enum": [
        "development",
        "candidate"
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "executableName",
        "applicationDataId",
        "applicationDataRoot",
        "defaultInstallRoot",
        "version"
      ],
      "properties": {
        "name": {
          "const": "DSH Windows Launcher"
        },
        "executableName": {
          "const": "DshWindowsLauncher.exe"
        },
        "applicationDataId": {
          "const": "DshWindowsLauncher"
        },
        "applicationDataRoot": {
          "const": "%LOCALAPPDATA%\\DshWindowsLauncher"
        },
        "defaultInstallRoot": {
          "const": "%LOCALAPPDATA%\\Programs\\DshWindowsLauncher"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportedWindows",
        "compatibilityWindows",
        "linuxReference"
      ],
      "properties": {
        "supportedWindows": {
          "const": "Windows 11 25H2+ x64"
        },
        "compatibilityWindows": {
          "const": "Windows 10 22H2 x64"
        },
        "linuxReference": {
          "const": "Ubuntu Server 24.04 LTS x64"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotnetSdkVersion",
        "targetFramework",
        "runtimeIdentifier",
        "selfContained",
        "singleFile",
        "trimmed"
      ],
      "properties": {
        "dotnetSdkVersion": {
          "const": "10.0.400"
        },
        "targetFramework": {
          "const": "net10.0-windows"
        },
        "runtimeIdentifier": {
          "const": "win-x64"
        },
        "selfContained": {
          "const": true
        },
        "singleFile": {
          "const": false
        },
        "trimmed": {
          "const": false
        }
      }
    },
    "pairingBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin",
        "referenceVersion",
        "cookieName",
        "acceptPage",
        "acceptPath",
        "heartbeatPath",
        "statusPath",
        "onlineWindowSeconds",
        "defaultHeartbeatIntervalSeconds"
      ],
      "properties": {
        "plugin": {
          "const": "@linxin666/dsh-remote-web-ui"
        },
        "referenceVersion": {
          "const": "0.3.10"
        },
        "cookieName": {
          "const": "dsh_pair"
        },
        "acceptPage": {
          "const": "/pair-accept"
        },
        "acceptPath": {
          "const": "/api/pair/accept"
        },
        "heartbeatPath": {
          "const": "/api/pair/heartbeat"
        },
        "statusPath": {
          "const": "/api/pair/status"
        },
        "onlineWindowSeconds": {
          "const": 25
        },
        "defaultHeartbeatIntervalSeconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 24
        }
      }
    },
    "verificationBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lastSupportedSignedReleaseCommit"
      ],
      "properties": {
        "lastSupportedSignedReleaseCommit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installerFileNameTemplate",
        "innoSetup",
        "signing",
        "officialReleaseUri"
      ],
      "properties": {
        "installerFileNameTemplate": {
          "const": "{Product}-Setup-{SemVer}-win-x64.exe"
        },
        "innoSetup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appId",
            "version",
            "sourceUri",
            "sha256"
          ],
          "properties": {
            "appId": {
              "const": "4440FC88-98CA-403E-8E20-3DFEBEF0E609"
            },
            "version": {
              "$ref": "#/$defs/pendingString"
            },
            "sourceUri": {
              "$ref": "#/$defs/pendingHttpsUri"
            },
            "sha256": {
              "$ref": "#/$defs/pendingSha256"
            }
          }
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "publisher",
            "certificateSubject",
            "timestampServerUri"
          ],
          "properties": {
            "policy": {
              "enum": [
                "optional",
                "required"
              ]
            },
            "publisher": {
              "$ref": "#/$defs/pendingString"
            },
            "certificateSubject": {
              "$ref": "#/$defs/pendingString"
            },
            "timestampServerUri": {
              "$ref": "#/$defs/pendingHttpsUri"
            }
          }
        },
        "officialReleaseUri": {
          "$ref": "#/$defs/pendingHttpUri"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTargets"
      ],
      "properties": {
        "maxTargets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "httpsUri": {
      "type": "string",
      "pattern": "^https://"
    },
    "httpUri": {
      "type": "string",
      "pattern": "^https?://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pendingString": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "pendingHttpsUri": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpsUri"
        },
        {
          "type": "null"
        }
      ]
    },
    "pendingHttpUri": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpUri"
        },
        {
          "type": "null"
        }
      ]
    },
    "pendingSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseStatus": {
            "const": "candidate"
          }
        },
        "required": [
          "releaseStatus"
        ]
      },
      "then": {
        "properties": {
          "distribution": {
            "properties": {
              "innoSetup": {
                "properties": {
                  "version": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "sourceUri": {
                    "$ref": "#/$defs/httpsUri"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              },
              "signing": {
                "properties": {
                  "publisher": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                }
              },
              "officialReleaseUri": {
                "$ref": "#/$defs/httpUri"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "releaseStatus": {
            "const": "candidate"
          },
          "distribution": {
            "properties": {
              "signing": {
                "properties": {
                  "policy": {
                    "const": "required"
                  }
                },
                "required": [
                  "policy"
                ]
              }
            },
            "required": [
              "signing"
            ]
          }
        },
        "required": [
          "releaseStatus",
          "distribution"
        ]
      },
      "then": {
        "properties": {
          "distribution": {
            "properties": {
              "signing": {
                "properties": {
                  "certificateSubject": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "timestampServerUri": {
                    "$ref": "#/$defs/httpsUri"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
