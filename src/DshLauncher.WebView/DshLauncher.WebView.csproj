<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DshLauncher.WebView</RootNamespace>
    <AssemblyName>DshLauncher.WebView</AssemblyName>
    <Description>绑定单个目标的受限 WebView2 内容宿主。</Description>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DshLauncher.Core/DshLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
</Project>
