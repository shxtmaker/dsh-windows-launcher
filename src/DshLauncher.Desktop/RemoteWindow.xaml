<Window x:Class="DshLauncher.Desktop.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DshLauncher.Desktop"
        Title="远程界面" Width="1280" Height="820"
        Icon="Assets/dsh-app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static ui:UiPalette.WindowBrush}"
        Foreground="{x:Static ui:UiPalette.TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        WindowStyle="SingleBorderWindow">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0,1,0,0" CaptionHeight="0" CornerRadius="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 目标侧边栏：地址与配对/连接情况；可整体折叠 -->
        <Border x:Name="Sidebar" Grid.Column="0" Width="236"
                Background="{x:Static ui:UiPalette.SurfaceBrush}"
                BorderBrush="{x:Static ui:UiPalette.BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 侧栏头部即拖拽区/标题；折叠开关只保留顶栏的汉堡按钮 -->
                <Grid Grid.Row="0" Margin="14,10,14,10" Background="Transparent"
                      MouseLeftButtonDown="OnCaptionMouseLeftButtonDown"
                      MouseLeftButtonUp="OnCaptionMouseLeftButtonUp"
                      MouseMove="OnCaptionMouseMove">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="远程目标" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{x:Static ui:UiPalette.TextPrimaryBrush}" />
                        <TextBlock Text="TARGETS" FontSize="9" Margin="0,2,0,0"
                                   Foreground="{x:Static ui:UiPalette.TextMutedBrush}" />
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" x:Name="SidebarList" Padding="6,0"
                         SelectionMode="Single"
                         SelectionChanged="OnSidebarSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Background" Value="{x:Static ui:UiPalette.SurfaceAltBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding BaseUrl}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 当前目标强调条 -->
                                <Rectangle Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                                           Margin="0,0,9,0" Fill="{x:Static ui:UiPalette.AccentBrush}">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <!-- 连接状态点 -->
                                <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Top"
                                         Margin="0,5,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{x:Static ui:UiPalette.NeutralBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Connectivity}" Value="Online">
                                                    <Setter Property="Fill" Value="{x:Static ui:UiPalette.SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Connectivity}" Value="Offline">
                                                    <Setter Property="Fill" Value="{x:Static ui:UiPalette.DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="2" Margin="9,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="Medium"
                                               Foreground="{x:Static ui:UiPalette.TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AddressDisplay}" Margin="0,2,0,0"
                                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5"
                                               Foreground="{x:Static ui:UiPalette.TextMutedBrush}" />
                                </StackPanel>

                                <!-- 未配对/配对中/已失效时显示右侧状态 -->
                                <TextBlock Grid.Column="3" Text="{Binding PairingLabel}" FontSize="10"
                                           Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Foreground" Value="{x:Static ui:UiPalette.NeutralBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Pairing}" Value="Pairing">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="{x:Static ui:UiPalette.AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Pairing}" Value="AwaitingPairing">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="{x:Static ui:UiPalette.NeutralBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Pairing}" Value="Revoked">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="{x:Static ui:UiPalette.DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" BorderBrush="{x:Static ui:UiPalette.BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="14,10">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="HubFooterText" FontSize="10.5"
                                   Foreground="{x:Static ui:UiPalette.TextSecondaryBrush}"
                                   Text="枢纽状态加载中…" />
                        <TextBlock Text="点击目标可切换远程页面" FontSize="10" Margin="0,3,0,0"
                                   Foreground="{x:Static ui:UiPalette.TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 合并式标题栏：拖拽区 + 汉堡开关 + 目标地址 + 加载状态 + 窗口控制 -->
            <Border Grid.Row="0" Background="{x:Static ui:UiPalette.SurfaceBrush}"
                    BorderBrush="{x:Static ui:UiPalette.BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Height="44" Background="Transparent"
                      MouseLeftButtonDown="OnCaptionMouseLeftButtonDown"
                      MouseLeftButtonUp="OnCaptionMouseLeftButtonUp"
                      MouseMove="OnCaptionMouseMove">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource TechIconButton}"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Click="OnToggleSidebar" ToolTip="展开/折叠侧边栏">
                        <Path Data="M3,5.5 H15 M3,9.5 H15 M3,13.5 H15"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <TextBlock x:Name="TargetText" Grid.Column="1" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{x:Static ui:UiPalette.TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Ellipse x:Name="StateDot" Width="8" Height="8"
                                 Fill="{x:Static ui:UiPalette.AccentBrush}" />
                        <TextBlock x:Name="StateText" Margin="7,0,0,0" FontSize="11.5"
                                   Foreground="{x:Static ui:UiPalette.TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- 统一 18x18 元素盒内的绝对坐标字形，三键同规格且垂直严格居中 -->
                        <Button Style="{StaticResource TechIconButton}" Click="OnMinimizeWindow" ToolTip="最小化">
                            <Path Width="18" Height="18" Data="M3,9 H15"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button Style="{StaticResource TechIconButton}" x:Name="MaximizeButton"
                                Click="OnMaximizeWindow" ToolTip="最大化">
                            <Path Width="18" Height="18" x:Name="MaximizeGlyph" Data="M4.5,4.5 H13.5 V13.5 H4.5 Z" Fill="Transparent"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" />
                        </Button>
                        <Button Style="{StaticResource TechIconButton}" Click="OnCloseWindow" ToolTip="关闭">
                            <Path Width="18" Height="18" Data="M4.5,4.5 L13.5,13.5 M13.5,4.5 L4.5,13.5"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListBox x:Name="PageTabs" SelectionMode="Single" Padding="6"
                         SelectionChanged="OnPageSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <Grid Grid.Row="1" x:Name="PageHost" />
            </Grid>
        </Grid>
    </Grid>
</Window>
