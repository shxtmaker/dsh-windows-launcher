<Window x:Class="DshLauncher.Desktop.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DshLauncher.Desktop"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{x:Static ui:UiPalette.WindowBrush}"
        Foreground="{x:Static ui:UiPalette.TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        ui:UiChrome.DarkTitleBar="True">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" FontSize="13"
                   Foreground="{x:Static ui:UiPalette.TextPrimaryBrush}" Margin="0,0,0,10" />
        <TextBox x:Name="ValueText" Margin="0,0,0,12"
                 TextWrapping="Wrap" AcceptsReturn="False"
                 SpellCheck.IsEnabled="False" />
        <TextBlock x:Name="ExtraLabelText" Text="显示名称（可选）" Visibility="Collapsed" Margin="0,0,0,8"
                   FontSize="12" Foreground="{x:Static ui:UiPalette.TextSecondaryBrush}" />
        <TextBox x:Name="ExtraText" Visibility="Collapsed" Margin="0,0,0,14" MaxLength="64" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="11"
                       Foreground="{x:Static ui:UiPalette.TextMutedBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="取消" Margin="0,0,8,0" IsCancel="True" />
            <Button Grid.Column="2" Content="确定" Style="{StaticResource TechPrimaryButton}"
                    Click="OnConfirm" IsDefault="True" />
        </Grid>
    </StackPanel>
</Window>
