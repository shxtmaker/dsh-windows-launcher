<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DshLauncher.Desktop</RootNamespace>
    <AssemblyName>DshWindowsLauncher</AssemblyName>
    <Product>$(LauncherProductName)</Product>
    <Description>$(LauncherProductName) 的 WPF 表示层与组合根。</Description>
    <UseWPF>true</UseWPF>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DshLauncher.Compatibility/DshLauncher.Compatibility.csproj" />
    <ProjectReference Include="../DshLauncher.Core/DshLauncher.Core.csproj" />
    <ProjectReference Include="../DshLauncher.Platform.Windows/DshLauncher.Platform.Windows.csproj" />
    <ProjectReference Include="../DshLauncher.WebView/DshLauncher.WebView.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../eng/release-constants.json"
                      LogicalName="DshLauncher.Desktop.ReleaseConstants.json" />
    <EmbeddedResource Include="../../compatibility/contracts/webui-contract-capabilities.json"
                      LogicalName="DshLauncher.Desktop.WebUiContractCapabilities.json" />
    <EmbeddedResource Include="../../compatibility/registry/webui-adapter-registry.json"
                      LogicalName="DshLauncher.Desktop.WebUiAdapterRegistry.json" />
  </ItemGroup>

  <Target Name="RenameInternalTestBuildAppHost"
          AfterTargets="Build"
          Condition="'$(LauncherBuildFlavor)' == 'InternalTest' and Exists('$(TargetDir)$(AssemblyName).exe')">
    <Move SourceFiles="$(TargetDir)$(AssemblyName).exe"
          DestinationFiles="$(TargetDir)$(LauncherExecutableBaseName).exe" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)$(LauncherExecutableBaseName).exe" />
    </ItemGroup>
  </Target>

  <Target Name="RenameInternalTestPublishedAppHost"
          AfterTargets="Publish"
          Condition="'$(LauncherBuildFlavor)' == 'InternalTest' and Exists('$(PublishDir)$(AssemblyName).exe')">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(PublishDir)$(LauncherExecutableBaseName).exe" />
    <ItemGroup>
      <FileWrites Include="$(PublishDir)$(LauncherExecutableBaseName).exe" />
    </ItemGroup>
  </Target>
</Project>
