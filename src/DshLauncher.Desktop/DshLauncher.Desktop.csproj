<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DshLauncher.Desktop</RootNamespace>
    <AssemblyName>DshWindowsLauncher</AssemblyName>
    <Product>$(LauncherProductName)</Product>
    <Description>$(LauncherProductName) 的 Windows 托盘宿主与组合根：集中管理配对、保活连接并托管独立 Web 管理页面。</Description>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DshLauncher.Core/DshLauncher.Core.csproj" />
    <ProjectReference Include="../DshLauncher.Platform.Windows/DshLauncher.Platform.Windows.csproj" />
    <ProjectReference Include="../DshLauncher.WebUi/DshLauncher.WebUi.csproj" />
  </ItemGroup>

  <Target Name="RenameInternalTestBuildAppHost"
          AfterTargets="Build"
          Condition="'$(LauncherBuildFlavor)' == 'InternalTest' and Exists('$(TargetDir)$(AssemblyName).exe')">
    <Move SourceFiles="$(TargetDir)$(AssemblyName).exe"
          DestinationFiles="$(TargetDir)$(LauncherExecutableBaseName).exe" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)$(LauncherExecutableBaseName).exe" />
    </ItemGroup>
  </Target>

  <Target Name="RenameInternalTestPublishedAppHost"
          AfterTargets="Publish"
          Condition="'$(LauncherBuildFlavor)' == 'InternalTest' and Exists('$(PublishDir)$(AssemblyName).exe')">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(PublishDir)$(LauncherExecutableBaseName).exe" />
    <ItemGroup>
      <FileWrites Include="$(PublishDir)$(LauncherExecutableBaseName).exe" />
    </ItemGroup>
  </Target>
</Project>
