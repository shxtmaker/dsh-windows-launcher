<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows 客户端外壳：保留 WPF/WinForms/WebView2 与 win-x64 RID。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DshLauncher.Desktop</RootNamespace>
    <AssemblyName>DshWindowsLauncher</AssemblyName>
    <Product>$(LauncherProductName)</Product>
    <Description>$(LauncherProductName) 的独立客户端：集中管理配对、保活连接，并内嵌显示 Harness 远程界面。</Description>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>../../assets/icons/dsh-app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <Resource Include="../../assets/icons/dsh-app.ico" Link="Assets/dsh-app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DshLauncher.Core/DshLauncher.Core.csproj" />
    <ProjectReference Include="../DshLauncher.Platform.Windows/DshLauncher.Platform.Windows.csproj" />
  </ItemGroup>

  <Target Name="RenameInternalTestBuildAppHost"
          AfterTargets="Build"
          Condition="'$(LauncherBuildFlavor)' == 'InternalTest' and Exists('$(TargetDir)$(AssemblyName).exe')">
    <Move SourceFiles="$(TargetDir)$(AssemblyName).exe"
          DestinationFiles="$(TargetDir)$(LauncherExecutableBaseName).exe" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)$(LauncherExecutableBaseName).exe" />
    </ItemGroup>
  </Target>

  <Target Name="RenameInternalTestPublishedAppHost"
          AfterTargets="Publish"
          Condition="'$(LauncherBuildFlavor)' == 'InternalTest' and Exists('$(PublishDir)$(AssemblyName).exe')">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(PublishDir)$(LauncherExecutableBaseName).exe" />
    <ItemGroup>
      <FileWrites Include="$(PublishDir)$(LauncherExecutableBaseName).exe" />
    </ItemGroup>
  </Target>
</Project>
