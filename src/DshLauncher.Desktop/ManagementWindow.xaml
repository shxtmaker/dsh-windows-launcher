<Window x:Class="DshLauncher.Desktop.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DshLauncher.Desktop"
        Title="DSH 集中配对管理" Width="960" Height="620"
        MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static ui:UiPalette.WindowBrush}"
        Foreground="{x:Static ui:UiPalette.TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        ui:UiChrome.DarkTitleBar="True">
    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center"
                        Background="{x:Static ui:UiPalette.SurfaceAltBrush}"
                        BorderBrush="{x:Static ui:UiPalette.AccentBorderBrush}"
                        BorderThickness="1">
                    <TextBlock Text="DSH" FontSize="9.5" FontWeight="Bold"
                               Foreground="{x:Static ui:UiPalette.AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DSH 集中配对管理" FontSize="16.5" FontWeight="SemiBold"
                               Foreground="{x:Static ui:UiPalette.TextPrimaryBrush}" />
                    <TextBlock x:Name="HubStatusText" Margin="0,3,0,0" FontSize="11.5"
                               Foreground="{x:Static ui:UiPalette.TextMutedBrush}"
                               Text="正在加载枢纽状态…" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="添加目标" Style="{StaticResource TechPrimaryButton}"
                    Padding="18,7" MinWidth="96" VerticalAlignment="Center"
                    Click="OnAddTarget" />
        </Grid>

        <ListBox Grid.Row="1" x:Name="TargetsList" Margin="0,14,0,0" Padding="0,2"
                 SelectionMode="Single"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent"
                          ToolTip="{Binding BaseUrl}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 选中行的强调条 -->
                        <Rectangle Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                                   Margin="0,0,11,0" Fill="{x:Static ui:UiPalette.AccentBrush}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <!-- 连接状态点 -->
                        <Ellipse Grid.Column="1" Width="9" Height="9" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{x:Static ui:UiPalette.NeutralBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connectivity}" Value="Online">
                                            <Setter Property="Fill" Value="{x:Static ui:UiPalette.SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Connectivity}" Value="Offline">
                                            <Setter Property="Fill" Value="{x:Static ui:UiPalette.DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{x:Static ui:UiPalette.TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AddressDisplay}" Margin="0,2,0,0"
                                       FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                                       Foreground="{x:Static ui:UiPalette.TextMutedBrush}" />
                        </StackPanel>

                        <!-- 配对状态徽标 -->
                        <Border Grid.Column="3" CornerRadius="9" Padding="9,2.5" Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{x:Static ui:UiPalette.NeutralSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{x:Static ui:UiPalette.NeutralBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Pairing}" Value="Paired">
                                            <Setter Property="Background" Value="{x:Static ui:UiPalette.SuccessSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{x:Static ui:UiPalette.SuccessBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Pairing}" Value="Pairing">
                                            <Setter Property="Background" Value="{x:Static ui:UiPalette.AccentSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{x:Static ui:UiPalette.AccentBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Pairing}" Value="Revoked">
                                            <Setter Property="Background" Value="{x:Static ui:UiPalette.DangerSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{x:Static ui:UiPalette.DangerBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PairingText}" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{x:Static ui:UiPalette.NeutralBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Pairing}" Value="Paired">
                                                <Setter Property="Foreground" Value="{x:Static ui:UiPalette.SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Pairing}" Value="Pairing">
                                                <Setter Property="Foreground" Value="{x:Static ui:UiPalette.AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Pairing}" Value="Revoked">
                                                <Setter Property="Foreground" Value="{x:Static ui:UiPalette.DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- 连接文字 -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{x:Static ui:UiPalette.NeutralBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connectivity}" Value="Online">
                                                <Setter Property="Fill" Value="{x:Static ui:UiPalette.SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Connectivity}" Value="Offline">
                                                <Setter Property="Fill" Value="{x:Static ui:UiPalette.DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectivityText}" Margin="6,0,0,0" FontSize="11.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{x:Static ui:UiPalette.TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connectivity}" Value="Online">
                                                <Setter Property="Foreground" Value="{x:Static ui:UiPalette.SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Connectivity}" Value="Offline">
                                                <Setter Property="Foreground" Value="{x:Static ui:UiPalette.DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- 最近心跳 -->
                        <TextBlock Grid.Column="5" Text="{Binding LastHeartbeatText}" Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                                   Foreground="{x:Static ui:UiPalette.TextMutedBrush}" />

                        <!-- 异常 -->
                        <TextBlock Grid.Column="6" Text="{Binding FailureText}" Margin="16,0,0,0"
                                   VerticalAlignment="Center" MaxWidth="170"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FailureText}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5"
                                   Foreground="{x:Static ui:UiPalette.WarningBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFailure}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,14,0,0">
            <Border Height="1" Background="{x:Static ui:UiPalette.BorderBrush}" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 底部操作区：五个等宽按钮同一规格（MinWidth/Height/Padding 完全一致） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="HeartbeatButton" Content="立即心跳" Margin="0,0,10,0"
                            MinWidth="112" Height="34" Padding="10,0"
                            Click="OnHeartbeatNow" IsEnabled="False" />
                    <Button x:Name="OpenRemoteButton" Content="打开远程界面" Margin="0,0,10,0"
                            MinWidth="112" Height="34" Padding="10,0"
                            Click="OnOpenRemote" IsEnabled="False" />
                    <Button x:Name="RePairButton" Content="重新配对" Margin="0,0,10,0"
                            MinWidth="112" Height="34" Padding="10,0"
                            Click="OnRePair" IsEnabled="False" />
                    <Button x:Name="RenameButton" Content="重命名" Margin="0,0,10,0"
                            MinWidth="112" Height="34" Padding="10,0"
                            Click="OnRename" IsEnabled="False" />
                    <Button x:Name="DeleteButton" Content="删除"
                            Style="{StaticResource TechDangerButton}"
                            MinWidth="112" Height="34" Padding="10,0"
                            Click="OnDelete" IsEnabled="False" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                           Foreground="{x:Static ui:UiPalette.TextMutedBrush}"
                           Text="双击列表项也可打开远程界面" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
