<Window x:Class="DshLauncher.Desktop.Dialogs.RenameTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:DshLauncher.Desktop.Resources"
        Title="{x:Static resources:Strings.RenameTitle}"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static resources:Strings.RenameTitle}">
  <StackPanel Margin="24">
    <TextBlock Text="{x:Static resources:Strings.RenameHeading}"
               FontSize="22" FontWeight="SemiBold" />
    <TextBlock Margin="0,6,0,16" Text="{x:Static resources:Strings.RenameDescription}"
               TextWrapping="Wrap" />
    <Label Target="{Binding ElementName=DisplayNameBox}"
           Content="{x:Static resources:Strings.DisplayNameLabel}" />
    <TextBox x:Name="DisplayNameBox" />
    <StackPanel Margin="0,18,-4,-4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{x:Static resources:Strings.ButtonCancel}" IsCancel="True" />
      <Button Content="{x:Static resources:Strings.ButtonConfirm}" IsDefault="True" Click="ConfirmClick" />
    </StackPanel>
  </StackPanel>
</Window>
