<Window x:Class="DshLauncher.Desktop.Dialogs.AddTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:DshLauncher.Desktop.Resources"
        Title="{x:Static resources:Strings.AddTargetTitle}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static resources:Strings.AddTargetTitle}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="{x:Static resources:Strings.AddTargetHeading}"
               FontSize="22" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Margin="0,6,0,18"
               Text="{x:Static resources:Strings.AddTargetDescription}"
               TextWrapping="Wrap" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label Grid.Row="0" Target="{Binding ElementName=Ipv4Box}"
             Content="{x:Static resources:Strings.Ipv4Label}" />
      <TextBox x:Name="Ipv4Box" Grid.Row="0" Grid.Column="1"
               AutomationProperties.HelpText="{x:Static resources:Strings.Ipv4Help}" />
      <Label Grid.Row="1" Target="{Binding ElementName=PortBox}"
             Content="{x:Static resources:Strings.PortLabel}" />
      <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
               AutomationProperties.HelpText="{x:Static resources:Strings.PortHelp}" />
      <Label Grid.Row="2" Target="{Binding ElementName=DisplayNameBox}"
             Content="{x:Static resources:Strings.DisplayNameLabel}" />
      <TextBox x:Name="DisplayNameBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
               AutomationProperties.HelpText="{x:Static resources:Strings.DisplayNameHelp}" />
    </Grid>
    <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="140,10,0,0"
               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    <StackPanel Grid.Row="4" Margin="0,20,-4,-4" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="{x:Static resources:Strings.ButtonCancel}" IsCancel="True" />
      <Button Content="{x:Static resources:Strings.ButtonContinue}" IsDefault="True"
              Click="ContinueClick" />
    </StackPanel>
  </Grid>
</Window>
