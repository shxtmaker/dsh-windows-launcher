<Window x:Class="DshLauncher.Desktop.Dialogs.PairTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:DshLauncher.Desktop.Resources"
        Title="{x:Static resources:Strings.PairTargetTitle}"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static resources:Strings.PairTargetTitle}">
  <StackPanel Margin="24">
    <TextBlock Text="{x:Static resources:Strings.PairTargetHeading}"
               FontSize="22" FontWeight="SemiBold" />
    <TextBlock Margin="0,6,0,16" Text="{x:Static resources:Strings.PairTargetDescription}"
               TextWrapping="Wrap" />
    <Label Target="{Binding ElementName=PairingLinkBox}"
           Content="{x:Static resources:Strings.PairingLinkLabel}" />
    <PasswordBox x:Name="PairingLinkBox" MinHeight="34" Padding="6,4"
                 AllowDrop="False"
                 AutomationProperties.Name="{x:Static resources:Strings.PairingLinkAutomationName}" />
    <TextBlock x:Name="PasteOnlyError" Margin="0,8,0,0"
               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
               Text="{x:Static resources:Strings.PairingLinkPasteOnly}"
               TextWrapping="Wrap" Visibility="Collapsed"
               AutomationProperties.LiveSetting="Assertive" />
    <TextBlock Margin="0,10,0,0" Text="{x:Static resources:Strings.PairingSecretNotice}"
               TextWrapping="Wrap" />
    <StackPanel Margin="0,18,-4,-4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{x:Static resources:Strings.ButtonCancel}" IsCancel="True" />
      <Button Content="{x:Static resources:Strings.ButtonConfirm}" IsDefault="True" Click="ConfirmClick" />
    </StackPanel>
  </StackPanel>
</Window>
