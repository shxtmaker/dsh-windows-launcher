<Window x:Class="DshLauncher.Desktop.Dialogs.ForgetTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:DshLauncher.Desktop.Resources"
        Title="{x:Static resources:Strings.ForgetTitle}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static resources:Strings.ForgetTitle}">
  <StackPanel Margin="24">
    <TextBlock Text="{x:Static resources:Strings.ForgetTitle}"
               FontSize="22" FontWeight="SemiBold" />
    <TextBlock Margin="0,10,0,0" Text="{Binding TargetName}" FontWeight="SemiBold" />
    <TextBlock Margin="0,2,0,12" Text="{Binding Endpoint}" />
    <TextBlock Text="{x:Static resources:Strings.ForgetPrompt}" TextWrapping="Wrap" />
    <StackPanel x:Name="SuccessorPanel" Margin="0,14,0,0">
      <Label Target="{Binding ElementName=SuccessorBox}"
             Content="{x:Static resources:Strings.SuccessorLabel}" />
      <ComboBox x:Name="SuccessorBox" DisplayMemberPath="EffectiveDisplayName"
                ItemsSource="{Binding Successors}" />
    </StackPanel>
    <StackPanel Margin="0,18,-4,-4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{x:Static resources:Strings.ButtonCancel}" IsCancel="True" />
      <Button Content="{x:Static resources:Strings.ButtonForget}" IsDefault="True" Click="ConfirmClick" />
    </StackPanel>
  </StackPanel>
</Window>
