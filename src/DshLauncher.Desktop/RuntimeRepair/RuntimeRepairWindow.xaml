<Window x:Class="DshLauncher.Desktop.RuntimeRepair.RuntimeRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:DshLauncher.Desktop.Resources"
        Title="{x:Static resources:Strings.RuntimeRepairTitle}"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="{x:Static resources:Strings.RuntimeRepairTitle}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{x:Static resources:Strings.RuntimeRepairHeading}"
               FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="DescriptionText" Grid.Row="1" Margin="0,12,0,0"
               TextWrapping="Wrap" />
    <Border Grid.Row="2" Margin="0,16,0,0" Padding="12"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1">
      <TextBlock x:Name="OnlineRepairText" TextWrapping="Wrap" />
    </Border>
    <TextBlock Grid.Row="3" Margin="0,12,0,0"
               Text="{x:Static resources:Strings.RuntimeRepairOfflineGuidance}"
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="4" Margin="0,16,0,0">
      <ProgressBar x:Name="RepairProgress" Height="4" IsIndeterminate="True"
                   Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
    <StackPanel Grid.Row="5" Margin="0,20,0,0" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button x:Name="CloseButton"
              Content="{x:Static resources:Strings.ButtonClose}"
              IsCancel="True"
              AutomationProperties.Name="{x:Static resources:Strings.ButtonClose}" />
      <Button x:Name="RepairButton"
              Content="{x:Static resources:Strings.ButtonRepairRuntime}"
              IsDefault="True"
              Click="RepairClick"
              AutomationProperties.Name="{x:Static resources:Strings.ButtonRepairRuntime}" />
    </StackPanel>
  </Grid>
</Window>
