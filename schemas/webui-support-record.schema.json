{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dshwindowslauncher.invalid/webui-support-record.schema.json",
  "title": "DSH Windows Launcher WebUI support record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "supportRecordId",
    "supportState",
    "components",
    "baseline",
    "contractVersion",
    "registryVersion",
    "rules",
    "launcher",
    "runtimeEvidence",
    "fixtureIdentity",
    "structuredEvidenceSha256",
    "supportScope",
    "knownLimitations",
    "lastVerifiedAt",
    "reviewDueAt",
    "ownerRef"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "supportRecordId": {
      "$ref": "#/$defs/recordId"
    },
    "supportState": {
      "enum": [
        "NoFormalSupport",
        "Supported",
        "Paused",
        "Superseded",
        "PlannedDeprecation",
        "Revoked"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "contractVersion": {
      "$ref": "#/$defs/semver"
    },
    "registryVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleIdentity"
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "installerSha256",
        "signatureStatus"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "installerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "signatureStatus": {
          "enum": [
            "not-applicable",
            "valid-trusted-timestamp"
          ]
        }
      }
    },
    "runtimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumRuntime",
        "evergreenRuntime",
        "sameEndpointEdge"
      ],
      "properties": {
        "minimumRuntime": {
          "$ref": "#/$defs/evidenceResult"
        },
        "evergreenRuntime": {
          "$ref": "#/$defs/evidenceResult"
        },
        "sameEndpointEdge": {
          "$ref": "#/$defs/evidenceResult"
        }
      }
    },
    "fixtureIdentity": {
      "$ref": "#/$defs/sha256"
    },
    "structuredEvidenceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "supportScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "lastVerifiedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "reviewDueAt": {
      "$ref": "#/$defs/dateTime"
    },
    "ownerRef": {
      "$ref": "#/$defs/safeReference"
    },
    "reviewDecisionId": {
      "$ref": "#/$defs/recordId"
    },
    "deprecationDate": {
      "$ref": "#/$defs/dateTime"
    },
    "tombstoneReasonCode": {
      "$ref": "#/$defs/reasonCode"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "safeReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reasonCode": {
      "enum": [
        "INCOMPLETE_IDENTITY",
        "UNREPRODUCIBLE",
        "ROUTE_SECURITY_FAILED",
        "OUTSIDE_GLOBAL_CEILING",
        "RULE_TOO_BROAD",
        "GATE_FAILED",
        "IDENTITY_MISMATCH",
        "MAINTENANCE_ENDED",
        "PROVIDER_WITHDRAWN",
        "DEPENDENCY_UNAVAILABLE"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uiId",
        "uiVersion",
        "sourceRev"
      ],
      "properties": {
        "uiId": {
          "$ref": "#/$defs/recordId"
        },
        "uiVersion": {
          "$ref": "#/$defs/semver"
        },
        "sourceRev": {
          "type": "string",
          "minLength": 7,
          "maxLength": 128,
          "pattern": "^[0-9A-Za-z._-]+$"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harnessCommit",
        "lanPluginVersion",
        "routeVersion"
      ],
      "properties": {
        "harnessCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "lanPluginVersion": {
          "$ref": "#/$defs/semver"
        },
        "routeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ruleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/recordId"
        },
        "ruleVersion": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "evidenceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "result"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "MISSING",
            "NOT_APPLICABLE"
          ]
        }
      }
    }
  }
}
