{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dshwindowslauncher.invalid/webui-review-decision.schema.json",
  "title": "DSH Windows Launcher WebUI review decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "intakeIdentity",
    "reviewUnitId",
    "ruleCandidateSha256",
    "contractVersion",
    "descriptorSchemaSha256",
    "globalCeilingResult",
    "spoofingAnalysisRef",
    "requiredGates",
    "risks",
    "reasonCodes",
    "decision",
    "windowsCompatibilityMaintainer",
    "securityMaintainer",
    "decidedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "decisionId": {
      "$ref": "#/$defs/recordId"
    },
    "intakeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intakeId",
        "intakeRevision",
        "canonicalSha256"
      ],
      "properties": {
        "intakeId": {
          "$ref": "#/$defs/recordId"
        },
        "intakeRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "canonicalSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewUnitId": {
      "$ref": "#/$defs/recordId"
    },
    "ruleCandidateSha256": {
      "$ref": "#/$defs/sha256"
    },
    "contractVersion": {
      "$ref": "#/$defs/semver"
    },
    "descriptorSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "globalCeilingResult": {
      "enum": [
        "within-ceiling",
        "outside-ceiling",
        "undetermined"
      ]
    },
    "spoofingAnalysisRef": {
      "$ref": "#/$defs/safeReference"
    },
    "requiredGates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "pattern": "^(?:VFY-0[1-8]|RS-(?:0[1-9]|1[0-5])|minimum-runtime|evergreen-runtime|same-endpoint-edge|provider-suite)$"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safeText"
      }
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reasonCode"
      }
    },
    "decision": {
      "enum": [
        "ApprovedForVerification",
        "Rejected",
        "NeedsProvider",
        "Superseded"
      ]
    },
    "windowsCompatibilityMaintainer": {
      "$ref": "#/$defs/maintainerDecision"
    },
    "securityMaintainer": {
      "$ref": "#/$defs/maintainerDecision"
    },
    "decidedAt": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "safeReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reasonCode": {
      "enum": [
        "INCOMPLETE_IDENTITY",
        "UNREPRODUCIBLE",
        "ROUTE_SECURITY_FAILED",
        "OUTSIDE_GLOBAL_CEILING",
        "RULE_TOO_BROAD",
        "GATE_FAILED",
        "IDENTITY_MISMATCH",
        "MAINTENANCE_ENDED",
        "PROVIDER_WITHDRAWN",
        "DEPENDENCY_UNAVAILABLE"
      ]
    },
    "maintainerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerRef",
        "result"
      ],
      "properties": {
        "reviewerRef": {
          "$ref": "#/$defs/safeReference"
        },
        "result": {
          "enum": [
            "approve",
            "reject",
            "needs-information"
          ]
        }
      }
    }
  }
}
