{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dshwindowslauncher.invalid/webui-adapter-registry.schema.json",
  "title": "DSH Windows Launcher embedded WebUI adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "registryVersion",
    "activeRules",
    "tombstones"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "contractVersion": {
      "$ref": "#/$defs/semver"
    },
    "registryVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "activeRules": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/activeRule"
      }
    },
    "tombstones": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/tombstone"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "namespacedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "adapterKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^[0-9A-Za-z._-]+$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
    },
    "httpsOrigin": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://[a-z0-9.-]+:[1-9][0-9]{0,4}$"
    },
    "pathRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact",
            "segment-prefix"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/[^?#]*$"
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "origin",
        "path",
        "methods",
        "resourceTypes",
        "redirectPolicy"
      ],
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/capabilityId"
        },
        "origin": {
          "$ref": "#/$defs/httpsOrigin"
        },
        "path": {
          "$ref": "#/$defs/pathRule"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "OPTIONS"
            ]
          }
        },
        "resourceTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "document",
              "frame",
              "stylesheet",
              "image",
              "media",
              "font",
              "script",
              "fetch",
              "xhr",
              "websocket",
              "worker"
            ]
          }
        },
        "redirectPolicy": {
          "const": "none"
        },
        "parentOrigin": {
          "$ref": "#/$defs/httpsOrigin"
        },
        "queryKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "activeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "contractVersion",
        "evidenceBaseline",
        "match",
        "purpose",
        "grants"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/namespacedId"
        },
        "ruleVersion": {
          "$ref": "#/$defs/semver"
        },
        "contractVersion": {
          "$ref": "#/$defs/semver"
        },
        "evidenceBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "harnessCommit",
            "lanPluginVersion",
            "routeVersion"
          ],
          "properties": {
            "harnessCommit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "lanPluginVersion": {
              "$ref": "#/$defs/semver"
            },
            "routeVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uiId",
            "minimumUiVersion",
            "maximumUiVersion",
            "adapterKey"
          ],
          "properties": {
            "uiId": {
              "$ref": "#/$defs/namespacedId"
            },
            "minimumUiVersion": {
              "$ref": "#/$defs/semver"
            },
            "maximumUiVersion": {
              "$ref": "#/$defs/semver"
            },
            "sourceRev": {
              "$ref": "#/$defs/sourceRevision"
            },
            "adapterKey": {
              "$ref": "#/$defs/adapterKey"
            }
          }
        },
        "purpose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "displayName",
            "diagnosticName"
          ],
          "properties": {
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "diagnosticName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "grants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/grant"
          }
        }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "revokedFromRegistryVersion",
        "severity",
        "reasonCode"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/namespacedId"
        },
        "revokedFromRegistryVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "severity": {
          "enum": [
            "Critical",
            "High",
            "Medium",
            "Low"
          ]
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        }
      }
    },
    "reasonCode": {
      "enum": [
        "INCOMPLETE_IDENTITY",
        "UNREPRODUCIBLE",
        "ROUTE_SECURITY_FAILED",
        "OUTSIDE_GLOBAL_CEILING",
        "RULE_TOO_BROAD",
        "GATE_FAILED",
        "IDENTITY_MISMATCH",
        "MAINTENANCE_ENDED",
        "PROVIDER_WITHDRAWN",
        "DEPENDENCY_UNAVAILABLE"
      ]
    }
  }
}
