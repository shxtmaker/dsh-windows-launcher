{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dshwindowslauncher.invalid/webui-provider-intake.schema.json",
  "title": "DSH Windows Launcher WebUI provider intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intakeId",
    "intakeRevision",
    "applicationStateHistory",
    "provider",
    "components",
    "descriptor",
    "baseline",
    "ownerAttestations",
    "capabilitySlices",
    "externalDependencies",
    "conditionalCapabilityRequests",
    "providerSuite",
    "risk",
    "supportCommitment"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "intakeId": {
      "$ref": "#/$defs/recordId"
    },
    "intakeRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "applicationStateHistory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/applicationStateEntry"
      }
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "contractVersion",
        "canonicalSha256"
      ],
      "properties": {
        "schemaId": {
          "const": "https://schemas.dshwindowslauncher.invalid/webui-compatibility-descriptor.schema.json"
        },
        "contractVersion": {
          "$ref": "#/$defs/semver"
        },
        "canonicalSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "ownerAttestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeOwnerRef",
        "hostOrigin",
        "session",
        "csrf",
        "dataAuthorization",
        "errorSemantics"
      ],
      "properties": {
        "routeOwnerRef": {
          "$ref": "#/$defs/safeReference"
        },
        "hostOrigin": {
          "$ref": "#/$defs/attestation"
        },
        "session": {
          "$ref": "#/$defs/attestation"
        },
        "csrf": {
          "$ref": "#/$defs/attestation"
        },
        "dataAuthorization": {
          "$ref": "#/$defs/attestation"
        },
        "errorSemantics": {
          "$ref": "#/$defs/attestation"
        }
      }
    },
    "capabilitySlices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/capabilitySlice"
      }
    },
    "externalDependencies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/externalDependency"
      }
    },
    "conditionalCapabilityRequests": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capabilityId"
      }
    },
    "providerSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteId",
        "version",
        "command",
        "fixtureSha256",
        "expectedResultSha256"
      ],
      "properties": {
        "suiteId": {
          "$ref": "#/$defs/namespacedId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fixtureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "expectedResultSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataClassification",
        "privacyImpact",
        "threatModelRef",
        "knownLimitations",
        "exitPlan"
      ],
      "properties": {
        "dataClassification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "privacyImpact": {
          "$ref": "#/$defs/safeText"
        },
        "threatModelRef": {
          "$ref": "#/$defs/safeReference"
        },
        "knownLimitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safeText"
          }
        },
        "exitPlan": {
          "$ref": "#/$defs/safeText"
        }
      }
    },
    "supportCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportWindow",
        "changeNoticeChannel",
        "maintenanceOwnerRef",
        "maintenanceEndsWhen"
      ],
      "properties": {
        "supportWindow": {
          "$ref": "#/$defs/safeText"
        },
        "changeNoticeChannel": {
          "$ref": "#/$defs/safeReference"
        },
        "maintenanceOwnerRef": {
          "$ref": "#/$defs/safeReference"
        },
        "maintenanceEndsWhen": {
          "$ref": "#/$defs/safeText"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "namespacedId": {
      "$ref": "#/$defs/recordId"
    },
    "adapterKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^[0-9A-Za-z._-]+$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "safeReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reasonCode": {
      "enum": [
        "INCOMPLETE_IDENTITY",
        "UNREPRODUCIBLE",
        "ROUTE_SECURITY_FAILED",
        "OUTSIDE_GLOBAL_CEILING",
        "RULE_TOO_BROAD",
        "GATE_FAILED",
        "IDENTITY_MISMATCH",
        "MAINTENANCE_ENDED",
        "PROVIDER_WITHDRAWN",
        "DEPENDENCY_UNAVAILABLE"
      ]
    },
    "applicationStateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "changedAt",
        "responsibleRole"
      ],
      "properties": {
        "state": {
          "enum": [
            "Received",
            "AwaitingProvider",
            "InReview",
            "RuleCandidate",
            "Verification",
            "AwaitingSignedRelease",
            "ClosedSupported",
            "ClosedRejected",
            "ClosedProviderWithdrawn",
            "ClosedSuperseded"
          ]
        },
        "changedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "responsibleRole": {
          "$ref": "#/$defs/safeReference"
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "maintainerRef",
        "publicContactRef",
        "securityContactRef"
      ],
      "properties": {
        "providerId": {
          "$ref": "#/$defs/namespacedId"
        },
        "maintainerRef": {
          "$ref": "#/$defs/safeReference"
        },
        "publicContactRef": {
          "$ref": "#/$defs/safeReference"
        },
        "securityContactRef": {
          "$ref": "#/$defs/safeReference"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uiId",
        "uiVersion",
        "sourceRev",
        "sourceCommit",
        "buildSource"
      ],
      "properties": {
        "uiId": {
          "$ref": "#/$defs/namespacedId"
        },
        "uiVersion": {
          "$ref": "#/$defs/semver"
        },
        "sourceRev": {
          "$ref": "#/$defs/sourceRevision"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "buildSource": {
          "$ref": "#/$defs/safeReference"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harnessCommit",
        "lanPluginVersion",
        "routeVersion",
        "deploymentRef"
      ],
      "properties": {
        "harnessCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "lanPluginVersion": {
          "$ref": "#/$defs/semver"
        },
        "routeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deploymentRef": {
          "$ref": "#/$defs/safeReference"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidenceRef"
      ],
      "properties": {
        "status": {
          "enum": [
            "asserted",
            "not-applicable"
          ]
        },
        "evidenceRef": {
          "$ref": "#/$defs/safeReference"
        }
      }
    },
    "capabilitySlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterKey",
        "purpose",
        "capabilityIds"
      ],
      "properties": {
        "adapterKey": {
          "$ref": "#/$defs/adapterKey"
        },
        "purpose": {
          "$ref": "#/$defs/safeText"
        },
        "capabilityIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capabilityId"
          }
        }
      }
    },
    "externalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerRef",
        "purpose",
        "origin",
        "paths",
        "methods",
        "resourceTypes",
        "redirectPolicy",
        "stateDependency",
        "exitPlan"
      ],
      "properties": {
        "ownerRef": {
          "$ref": "#/$defs/safeReference"
        },
        "purpose": {
          "$ref": "#/$defs/safeText"
        },
        "origin": {
          "type": "string",
          "pattern": "^https://[a-z0-9.-]+:[1-9][0-9]{0,4}$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/[^?#]*$"
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "OPTIONS"
            ]
          }
        },
        "resourceTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "document",
              "frame",
              "stylesheet",
              "image",
              "media",
              "font",
              "script",
              "fetch",
              "xhr"
            ]
          }
        },
        "redirectPolicy": {
          "const": "none"
        },
        "stateDependency": {
          "$ref": "#/$defs/safeText"
        },
        "exitPlan": {
          "$ref": "#/$defs/safeText"
        }
      }
    }
  }
}
