{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dshwindowslauncher.invalid/webui-compatibility-descriptor.schema.json",
  "title": "DSH Windows Launcher WebUI compatibility descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "contractVersion": {
      "$ref": "#/$defs/semver"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "namespacedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "adapterKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^[0-9A-Za-z._-]+$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uiId",
        "uiVersion",
        "adapterKeys"
      ],
      "properties": {
        "uiId": {
          "$ref": "#/$defs/namespacedId"
        },
        "uiVersion": {
          "$ref": "#/$defs/semver"
        },
        "sourceRev": {
          "$ref": "#/$defs/sourceRevision"
        },
        "adapterKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/adapterKey"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/namespacedId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/extensionValue"
      }
    },
    "extensionPropertyName": {
      "not": {
        "enum": [
          "origin",
          "parentOrigin",
          "path",
          "methods",
          "resourceTypes",
          "resourceKinds",
          "queryKeys",
          "redirectPolicy",
          "capabilityId",
          "capabilities",
          "csp",
          "permissions",
          "documentScope"
        ]
      }
    },
    "extensionValue": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "string"
          ]
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extensionValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/extensionPropertyName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/extensionValue"
          }
        }
      ]
    }
  }
}
