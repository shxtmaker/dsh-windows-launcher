{
  "schemaVersion": 1,
  "contractVersion": "1.0.0",
  "descriptorSchemaId": "https://schemas.dshwindowslauncher.invalid/webui-compatibility-descriptor.schema.json",
  "limits": {
    "descriptorBytes": 65536,
    "descriptorComponents": 64,
    "jsonDepth": 32
  },
  "methodCeilings": {
    "passiveResource": [
      "GET",
      "HEAD"
    ],
    "reviewedApi": [
      "GET",
      "OPTIONS",
      "POST"
    ]
  },
  "baseCapabilities": [
    {
      "capabilityId": "about-blank-frame",
      "description": "Parent-bound about:blank document without srcdoc."
    },
    {
      "capabilityId": "blob-data-read",
      "description": "Page-cycle-bound blob data read excluding downloads."
    },
    {
      "capabilityId": "blob-image",
      "description": "Page-cycle-bound blob image."
    },
    {
      "capabilityId": "blob-media",
      "description": "Page-cycle-bound blob media."
    },
    {
      "capabilityId": "data-image",
      "description": "Data URL image."
    },
    {
      "capabilityId": "find-in-page",
      "description": "User-initiated find in page."
    },
    {
      "capabilityId": "page-editing",
      "description": "Normal editing inside the target page."
    },
    {
      "capabilityId": "page-zoom",
      "description": "User-controlled page zoom."
    },
    {
      "capabilityId": "same-origin-frame",
      "description": "Any frame that remains on the exact target origin."
    },
    {
      "capabilityId": "target-api-request",
      "description": "Ordinary API request to the exact target origin."
    },
    {
      "capabilityId": "target-http-document",
      "description": "Top-level document from the exact target origin."
    },
    {
      "capabilityId": "target-http-resource",
      "description": "Ordinary HTTP resource from the exact target origin."
    },
    {
      "capabilityId": "target-sse",
      "description": "Server-sent events from the exact target origin."
    },
    {
      "capabilityId": "user-image-drop",
      "description": "User-initiated image drop handled by the target page."
    },
    {
      "capabilityId": "user-image-paste",
      "description": "User-initiated image paste handled by the target page."
    },
    {
      "capabilityId": "webgl-rendering",
      "description": "WebGL rendering within the target page."
    }
  ],
  "extensionCapabilities": [
    {
      "capabilityId": "external-reviewed-api",
      "description": "Reviewed external API slice with an exact origin and narrow path.",
      "methodCeiling": "reviewedApi",
      "resourceTypes": [
        "fetch",
        "xhr"
      ],
      "mainDocumentScriptAllowed": false
    },
    {
      "capabilityId": "external-reviewed-frame",
      "description": "Reviewed cross-origin frame with an exact parent-child relation.",
      "methodCeiling": "passiveResource",
      "resourceTypes": [
        "document",
        "frame"
      ],
      "mainDocumentScriptAllowed": false
    },
    {
      "capabilityId": "external-reviewed-passive-resource",
      "description": "Reviewed passive external resource with an exact origin and narrow path.",
      "methodCeiling": "passiveResource",
      "resourceTypes": [
        "font",
        "image",
        "media",
        "stylesheet"
      ],
      "mainDocumentScriptAllowed": false
    }
  ],
  "conditionalCapabilities": [
    {
      "capabilityId": "audio-worklet",
      "status": "not-authorized",
      "requiredEvidence": [
        "evergreen-runtime",
        "minimum-runtime",
        "negative-arrival-count",
        "recovery",
        "same-endpoint-edge",
        "signed-candidate"
      ]
    },
    {
      "capabilityId": "cdp-fetch",
      "status": "not-authorized",
      "requiredEvidence": [
        "evergreen-runtime",
        "minimum-runtime",
        "negative-arrival-count",
        "recovery",
        "same-endpoint-edge",
        "signed-candidate"
      ]
    },
    {
      "capabilityId": "dedicated-worker",
      "status": "not-authorized",
      "requiredEvidence": [
        "evergreen-runtime",
        "minimum-runtime",
        "negative-arrival-count",
        "recovery",
        "same-endpoint-edge",
        "signed-candidate"
      ]
    },
    {
      "capabilityId": "external-reviewed-frame-script",
      "status": "not-authorized",
      "requiredEvidence": [
        "evergreen-runtime",
        "minimum-runtime",
        "negative-arrival-count",
        "recovery",
        "same-endpoint-edge",
        "signed-candidate"
      ]
    },
    {
      "capabilityId": "external-websocket",
      "status": "not-authorized",
      "requiredEvidence": [
        "evergreen-runtime",
        "minimum-runtime",
        "negative-arrival-count",
        "recovery",
        "same-endpoint-edge",
        "signed-candidate"
      ]
    },
    {
      "capabilityId": "oopif-frame",
      "status": "not-authorized",
      "requiredEvidence": [
        "evergreen-runtime",
        "minimum-runtime",
        "negative-arrival-count",
        "recovery",
        "same-endpoint-edge",
        "signed-candidate"
      ]
    },
    {
      "capabilityId": "redirect-hop",
      "status": "not-authorized",
      "requiredEvidence": [
        "evergreen-runtime",
        "minimum-runtime",
        "negative-arrival-count",
        "recovery",
        "same-endpoint-edge",
        "signed-candidate"
      ]
    },
    {
      "capabilityId": "shared-worker",
      "status": "not-authorized",
      "requiredEvidence": [
        "evergreen-runtime",
        "minimum-runtime",
        "negative-arrival-count",
        "recovery",
        "same-endpoint-edge",
        "signed-candidate"
      ]
    },
    {
      "capabilityId": "target-websocket",
      "status": "not-authorized",
      "requiredEvidence": [
        "evergreen-runtime",
        "minimum-runtime",
        "negative-arrival-count",
        "recovery",
        "same-endpoint-edge",
        "signed-candidate"
      ]
    }
  ],
  "permanentlyForbiddenCapabilities": [
    "about-srcdoc",
    "arbitrary-external-frame",
    "background-clipboard-read",
    "bare-https-source",
    "bare-ws-source",
    "basic-auth",
    "camera-permission",
    "certificate-bypass",
    "client-certificate",
    "default-browser-menu",
    "devtools-access",
    "download-file",
    "external-main-script",
    "file-scheme",
    "filesystem-object",
    "geolocation-permission",
    "host-object",
    "insecure-secure-context",
    "javascript-scheme",
    "linux-windows-transfer",
    "microphone-permission",
    "non-user-external-launch",
    "notification-permission",
    "persistent-offline-response",
    "print-to-file",
    "rule-expanded-blob-script",
    "runtime-rule-edit",
    "save-page",
    "service-worker",
    "shared-buffer",
    "unknown-scheme",
    "unreviewed-external-script",
    "unsafe-eval",
    "wasm-unsafe-eval",
    "web-message",
    "wildcard-host"
  ],
  "globalCspDebt": [
    {
      "capabilityId": "blob-script",
      "status": "blocked-pending-evidence",
      "description": "Blob script remains blocked until versioned A/B and dual-runtime evidence exists."
    },
    {
      "capabilityId": "unsafe-inline-script",
      "status": "blocked-pending-evidence",
      "description": "Unsafe inline script remains blocked until versioned A/B and dual-runtime evidence exists."
    }
  ]
}
